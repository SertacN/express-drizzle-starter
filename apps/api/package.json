{
	"name": "api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"check": "tsc --noEmit",
		"lint": "echo \"(no linter configured yet)\"",
		"format": "prettier --write \"{src,scripts}/**/*.ts\"",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/core/db/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"user:create": "tsx scripts/create-user.ts"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.5.2",
		"helmet": "^8.2.0",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.2.0",
		"pg": "^8.22.0",
		"shared": "workspace:*",
		"sharp": "^0.35.3",
		"ws": "^8.21.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.2.0",
		"@types/node": "^24.13.2",
		"@types/pg": "^8.20.0",
		"@types/ws": "^8.18.1",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	}
}
