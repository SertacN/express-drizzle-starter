{
	"name": "api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"check": "tsc --noEmit",
		"lint": "echo \"(no linter configured yet)\"",
		"format": "prettier --write \"{src,scripts}/**/*.ts\"",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/core/db/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"user:create": "tsx scripts/create-user.ts"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"drizzle-orm": "^0.45.3",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.0",
		"helmet": "^8.3.0",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.4.0",
		"pg": "^8.23.1",
		"shared": "workspace:*",
		"sharp": "^0.35.5",
		"ws": "^8.22.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.3.0",
		"@types/node": "^24.19.1",
		"@types/pg": "^8.23.1",
		"@types/ws": "^8.18.2",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
