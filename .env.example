# Copy to .env and edit. A single .env at the repo root feeds every app (see core/config/env.ts).
DOMAIN=example.com

NODE_ENV=development
PORT=3000

DB_NAME=app
DB_USER=app
DB_PASSWORD=change-me
DATABASE_URL=postgresql://app:change-me@localhost:5432/app

# The two secrets must differ — access and refresh token universes stay separate
# (checked at boot, the API refuses to start otherwise).
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Comma-separated list of allowed browser origins. Requests are credentialed (the web auth
# surface uses cookies), and browsers reject a wildcard origin with credentials — so empty
# means SAME-ORIGIN ONLY: run the frontend behind the dev proxy, or list its origin here.
CORS_ORIGIN=

# Root of uploaded files. Empty = ./uploads at the repo root.
# In production compose overrides this with /app/uploads (a persistent volume).
# UPLOAD_DIR=
